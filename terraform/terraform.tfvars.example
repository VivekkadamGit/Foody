# Copy to terraform.tfvars (git-ignored) and fill in from .env.local.
supabase_url              = "https://your-project-id.supabase.co"
supabase_anon_key         = "..."
supabase_service_role_key = "..."
gemini_api_key            = "..."

# Optional
# ai_search       = "off"
# container_power = "micro"  # 1 GB memory: $10/month instead of $7
# domain_name     = ""      # default chakh.in; empty = cloudfront.net address only
